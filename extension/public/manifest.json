{
  "manifest_version": 3,
  "name": "AIOS Rec",
  "description": "Record meetings into the AIOS recordings library with automatic transcription and summary",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://zvoijyneresvkadpprel.supabase.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
