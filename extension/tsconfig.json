{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "vite/client"],
    // ES2024 for String#toWellFormed and #isWellFormed: Chrome 111, below the manifest's minimum.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "../supabase/functions/_shared/carmen/device"],
  // Tests run under the root Vitest (vitest.config.ts), whose packages the extension does not install.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-fixture.ts",
    "../supabase/functions/**/*.test.ts",
    "../supabase/functions/**/*.test-fixture.ts"
  ]
}
