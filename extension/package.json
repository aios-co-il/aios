{
  "name": "aios-meeting-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "AIOS Chrome extension: record meetings (screen + audio), auto-transcribe and file them in the AIOS recordings library",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:staging": "vite build --watch --mode staging",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.16.5",
    "smol-toml": "^1.9.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
