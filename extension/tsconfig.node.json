{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "chrome"],
    "lib": ["ES2022"]
  },
  "include": ["vite.config.ts", "build"],
  // Tests run under the root Vitest (vitest.config.ts), whose packages the extension does not install.
  "exclude": ["build/**/*.test.ts"]
}
