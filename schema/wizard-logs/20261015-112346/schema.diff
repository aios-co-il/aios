+CREATE OR REPLACE FUNCTION "public"."claim_video_run"("p_kinds" "text"[], "p_worker" "text" DEFAULT NULL::"text") RETURNS SETOF "public"."marketing_runs"
+    LANGUAGE "plpgsql"
+    SET "search_path" TO 'public'
+    AS $$
+begin
+  if coalesce(current_setting('request.jwt.claims', true)::jsonb->>'role', '') <> 'service_role'
+     and current_user not in ('postgres', 'service_role') then
+    raise exception 'claim_video_run: service role only' using errcode = '42501';
+  end if;
+
+  return query
+  update public.marketing_runs as run
+     set status = 'running',
+         started_at = now(),
+         attempts = run.attempts + 1,
+         output = run.output || jsonb_strip_nulls(jsonb_build_object('worker', p_worker))
+   where run.id = (
+     select queued.id
+       from public.marketing_runs as queued
+      where queued.status = 'queued'
+        and queued.kind = any(p_kinds)
+      order by queued.created_at
+      limit 1
+      for update skip locked
+   )
+  returning run.*;
+end;
+$$;
