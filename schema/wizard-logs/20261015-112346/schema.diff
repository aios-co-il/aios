+CREATE OR REPLACE FUNCTION "public"."attach_video_scene_asset"("p_scene_id" "uuid", "p_kind" "text", "p_url" "text", "p_meta" "jsonb" DEFAULT '{}'::"jsonb", "p_run_id" "uuid" DEFAULT NULL::"uuid") RETURNS "public"."marketing_assets"
