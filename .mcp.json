{
  "mcpServers": {
    "aios-system-graph": {
      "type": "http",
      "url": "https://zvoijyneresvkadpprel.supabase.co/functions/v1/system-graph-mcp",
      "headers": {
        "Authorization": "Bearer ${AIOS_GRAPH_MCP_BEARER}"
      },
      "timeout": 60000
    },
    "Grok": {
      "type": "http",
      "url": "https://zvoijyneresvkadpprel.supabase.co/functions/v1/grok-mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${GROK_MCP_BEARER}"
      },
      "timeout": 120000
    },
    "AIOS Collaboration": {
      "type": "http",
      "url": "https://zvoijyneresvkadpprel.supabase.co/functions/v1/collaboration-mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${AIOS_COLLABORATION_MCP_BEARER}"
      },
      "timeout": 120000
    }
  }
}
