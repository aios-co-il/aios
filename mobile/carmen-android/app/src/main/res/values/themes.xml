<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Carmen Marketing OS palette (src/index.css dark theme, src/pages/Auth.tsx) -->
    <color name="carmen_primary">#3BDCB9</color>
    <color name="carmen_accent">#3BDCB9</color>
    <color name="carmen_alert">#FBBF24</color>
    <color name="carmen_background">#0A1526</color>
    <color name="carmen_card">#0D2134</color>
    <color name="carmen_text">#E8F1F8</color>
    <color name="carmen_muted">#8FA3B8</color>
    <style name="Theme.Carmen" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/carmen_primary</item>
        <item name="colorAccent">@color/carmen_primary</item>
        <item name="android:windowBackground">@color/carmen_background</item>
        <item name="android:statusBarColor">@color/carmen_background</item>
        <item name="android:navigationBarColor">@color/carmen_background</item>
    </style>

    <style name="Carmen.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/carmen_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Carmen.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/input_field</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/carmen_text</item>
        <item name="android:textColorHint">@color/carmen_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Carmen.PrimaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/primary_button</item>
        <item name="android:textColor">@color/carmen_background</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Carmen.OutlineButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/outline_button</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/carmen_text</item>
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
