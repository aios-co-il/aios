<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carmen_background"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="32dp">

    <View
        android:id="@+id/listening_indicator"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/listening_dot" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/carmen_listening"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

    <Button
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/close" />

    <Button
        android:id="@+id/false_activation_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/false_activation" />
</LinearLayout>
