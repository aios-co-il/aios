<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carmen_background"
    android:layoutDirection="rtl">

    <!-- Carmen's "video" tile, as the other side of a video call shows on a phone. -->
    <FrameLayout
        android:id="@+id/call_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/rounded_tile">

        <ImageView
            android:id="@+id/carmen_portrait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/carmen_call" />

        <!-- The looping clip of Carmen listening; the still above shows until it is ready. -->
        <VideoView
            android:id="@+id/carmen_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="invisible" />

        <!-- Active-speaker frame: glows while Carmen talks, as video calls mark who is speaking. -->
        <View
            android:id="@+id/portrait_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/speaker_frame" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/name_tag"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/call_tile_name"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/call_top_shade"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/live_dot" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/call_name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/call_bottom_shade"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/name_tag"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/carmen_listening"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notice_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/carmen_alert"
            android:visibility="gone" />

        <!-- Captions: Carmen's latest line only. -->
        <TextView
            android:id="@+id/caption_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="start"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mute_button"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/call_button"
                android:contentDescription="@string/mute"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/end_call_button"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_call_end" />
        </LinearLayout>

        <TextView
            android:id="@+id/false_activation_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="6dp"
            android:text="@string/false_activation"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
