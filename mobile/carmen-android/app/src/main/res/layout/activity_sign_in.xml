<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carmen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="200dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/carmen_portrait" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/brand_card"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:contentDescription="@string/brand_name"
                android:scaleType="fitCenter"
                android:src="@drawable/carmen_wordmark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/brand_tagline"
                android:textColor="@color/carmen_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sign_in_env"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/carmen_muted"
                android:textSize="12sp" />

            <TextView
                style="@style/Carmen.Label"
                android:layout_marginTop="20dp"
                android:text="@string/email_label" />

            <EditText
                android:id="@+id/email_input"
                style="@style/Carmen.Input"
                android:autofillHints="emailAddress"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Carmen.Label"
                android:layout_marginTop="12dp"
                android:text="@string/password_label" />

            <EditText
                android:id="@+id/password_input"
                style="@style/Carmen.Input"
                android:autofillHints="password"
                android:hint="@string/password_hint"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/sign_in_button"
                style="@style/Carmen.PrimaryButton"
                android:layout_marginTop="20dp"
                android:text="@string/sign_in" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:gravity="center"
                android:text="@string/or"
                android:textColor="@color/carmen_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/google_button"
                style="@style/Carmen.OutlineButton"
                android:drawableStart="@drawable/ic_google"
                android:text="@string/sign_in_google" />

            <TextView
                android:id="@+id/sign_in_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/carmen_alert"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
