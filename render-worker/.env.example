# One container per environment, built from that environment's branch (develop for Staging,
# main for Production). Every key in this file belongs to that one environment only.
WORKER_ENV=staging
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: otherwise the tenant's LLM integration key is used.
OPENAI_API_KEY=
WORKER_ID=droplet-staging-1
POLL_MS=5000
CONCURRENCY=8
# Default scene engine when a run does not name one: mock, kling, elevenlabs, higgsfield, openrouter.
VIDEO_PROVIDER=mock
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# ElevenLabs: clips (Veo), voiceover (eleven_v4) and music (music_v2_5).
# The tenant key in the LLM integration (elevenlabs_api_key) wins; this is the fallback.
# Also used for word-level transcripts with Scribe (Whisper otherwise).
ELEVENLABS_API_KEY=
# ELEVENLABS_VIDEO_MODEL=veo-3.1-fast-generate-001
# ELEVENLABS_TTS_MODEL=eleven_v4
# ELEVENLABS_MUSIC_MODEL=music_v2_5
# ELEVENLABS_VOICE_ID=
# Higgsfield image-to-video. Tenant keys: higgsfield_api_key_id / higgsfield_api_key_secret.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# HIGGSFIELD_VIDEO_MODEL=pixverse/v6
# OpenRouter video (also the fallback when a paid engine refuses before submit). The key is
# the tenant's OpenRouter brain in Carmen settings (Vault); there is no env key.
# OPENROUTER_VIDEO_MODEL=kwaivgi/kling-v3.0-std
# OPENROUTER_TALKING_MODEL=google/veo-3.1
# Planning estimates per second until the first paid run:
# OPENROUTER_VIDEO_USD_PER_SECOND=0.084
# OPENROUTER_TALKING_USD_PER_SECOND=0.4
# KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_MODEL=kling-v3
# KLING_MODE=pro
# Narration fallback after ElevenLabs and OpenRouter: Gemini TTS. The tenant's google_api_key wins.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# A Remotion render still running after this long is stopped (default 20 minutes).
# REMOTION_TIMEOUT_MS=1200000
# Optional runner, clip, lip-sync and sound settings: render-worker/README.md "Settings".
# Extra https hosts allowed for still downloads (comma-separated); Supabase hosts are built in.
# MEDIA_URL_HOSTS=
# OVERLAY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
