+// Non-object JSON is a malformed request (400). An object envelope that fails
+// the schema is acknowledged and logged so the provider keeps the webhook on.
+export function parseManusBody(body: unknown): ManusBodyResult {
+  if (!body || typeof body !== "object" || Array.isArray(body)) {
+    return { status: "not_object" };
+  }
+  const parsed = manusPayloadSchema.safeParse(body);
+  if (parsed.success) {
+    return { status: "ok", payload: parsed.data };
+  }
+  return {
+    status: "invalid",
+    issues: parsed.error.issues,
+    preview: JSON.stringify(body).slice(0, 800),
+  };
