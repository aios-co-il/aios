+          ),
+        );
+        assert(response.status === 400, "Expected invalid-payload 400");
+        assert(
+          (await response.json()).error === "Invalid payload",
+          "Expected invalid-payload response",
+        );
+        assert(
+          calls === 0,
+          "Invalid payload must not invoke downstream/database code",
+        );
+      },
+    );
+  }
+}
+Deno.test(
+  "passes flat and wrapped objects unchanged to processing",
+  async () => {
+    for (const payload of [
+      { instanceId: "test", body: "hi" },
+      { data: { instanceId: "test", body: "hi" }, extra: 42 },
+    ]) {
+      const handler = createWebhookHandler(async (_request, received) => {
+        assert(
+          JSON.stringify(received) === JSON.stringify(payload),
+          "Payload changed",
+        );
+        return new Response("processed");
+      });
+      const response = await handler(
+        new Request("https://example.test", {
+          method: "POST",
+          body: JSON.stringify(payload),
+        }),
+      );
+      assert(
+        (await response.text()) === "processed",
+        "Expected downstream response",
+      );
+    }
+  },
+);
+Deno.test("OPTIONS does not parse a body or invoke processing", async () => {
+  const handler = createWebhookHandler(async () => {
+    throw new Error("Unexpected processing");
+  });
+  const response = await handler(
+    new Request("https://example.test", { method: "OPTIONS" }),
+  );
+  assert(response.status === 200, "Expected preflight success");
+  assert(
+    response.headers.get("Access-Control-Allow-Origin") === "*",
+    "Expected CORS header",
+  );
+});
diff --git a/supabase/functions/manus-wa-webhook/request-handler.ts b/supabase/functions/manus-wa-webhook/request-handler.ts
new file mode 100644
index 000000000..792457c2a
--- /dev/null
+++ b/supabase/functions/manus-wa-webhook/request-handler.ts
@@ -0,0 +1,37 @@
+import type { Json } from "../_shared/database.types.ts";
+
+type Payload = Record<string, Json>;
+const corsHeaders = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers":
+    "authorization, x-client-info, apikey, content-type, x-wa-gateway-instance, x-wa-gateway-secret, x-webhook-secret, x-manus-secret, x-webhook-signature",
+};
+
+function isPayload(value: unknown): value is Payload {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/** Keep request decoding importable without starting a server or loading providers. */
+export function createWebhookHandler(
+  processPayload: (request: Request, payload: Payload) => Promise<Response>,
+) {
+  return async (request: Request): Promise<Response> => {
+    if (request.method === "OPTIONS")
+      return new Response(null, { headers: corsHeaders });
+    try {
+      const payload: unknown = await request.json();
+      if (!isPayload(payload))
+        return Response.json(
+          { error: "Invalid payload" },
+          { status: 400, headers: corsHeaders },
+        );
+      return await processPayload(request, payload);
+    } catch (error) {
+      console.error("Manus webhook request failed:", error);
+      return Response.json(
+        { error: error instanceof Error ? error.message : String(error) },
+        { status: 500, headers: corsHeaders },
+      );
+    }
+  };
+}
