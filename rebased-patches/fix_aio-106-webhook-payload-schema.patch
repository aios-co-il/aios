+  "preserves deeper extensions beyond the layers the handler consumes",
+  () => {
+    const payload = {
+      data: {
+        message: {
+          data: { providerExtension: { from: ["opaque", "extension"] } },
+        },
+      },
+    };
+    assert.deepEqual(manusPayloadSchema.parse(payload), payload);
