+const providerObject = z.record(z.string(), z.unknown());
+
+// Shared fields apply to messages and envelopes; opaque extensions stay intact.
+const messageFields = z
+  .object({
+    event: text,
+    type: text,
+    messageType: text,
+    instanceId: identifier,
+    instance_id: identifier,
+    secret: text,
+    id: identifier,
+    messageId: identifier,
+    from: identifier,
+    to: identifier,
+    chatId: identifier,
+    remoteJid: identifier,
+    recipientId: identifier,
